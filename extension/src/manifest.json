{
  "manifest_version": 3,
  "name": "UltraCalcPal Fuel Calculator",
  "version": "1.0.0",
  "description": "Carbs, fluids and sodium per hour for your ultra, from your weight, hours and the weather. Free, private, works offline.",
  "action": {
    "default_title": "UltraCalcPal Fuel Calculator",
    "default_popup": "popup.html",
    "default_icon": {
      "16": "icons/icon-16.png",
      "32": "icons/icon-32.png",
      "48": "icons/icon-48.png",
      "128": "icons/icon-128.png"
    }
  },
  "icons": {
    "16": "icons/icon-16.png",
    "32": "icons/icon-32.png",
    "48": "icons/icon-48.png",
    "128": "icons/icon-128.png"
  },
  "permissions": ["storage"],
  "homepage_url": "https://www.ultracalcpal.com/"
}
